{
  "name": "anonletter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @anonletter/web dev",
    "dev:worker": "pnpm --filter @anonletter/worker dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "vitest run",
    "db:migrate:local": "pnpm --filter @anonletter/worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter @anonletter/worker db:migrate:remote",
    "deploy:worker": "pnpm --filter @anonletter/worker deploy",
    "format": "biome format --write .",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  },
  "packageManager": "pnpm@9.12.0"
}

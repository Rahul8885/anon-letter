  "narrative": {
    "northStar": "A private letter left on a desk.",
    "overview": "The shell is quiet, human, contemporary and tactile. One continuous ivory desk carries live type, photographed stationery and restrained rose controls. The object supplies material character; readable DOM text supplies the message.",
    "keyCharacteristics": [
      "continuous paper",
      "headline-first hierarchy",
      "real photographic objects",
      "direct, skippable ceremony",
      "distinct mood rooms"
    ],
    "rules": [
      {
        "name": "The Paper Ink Rule",
        "body": "Text on photographed paper uses ink or soft ink, including signatures and small supporting lines.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep messages as selectable live DOM text over photographed material.",
      "Do preserve the five mood identities and the writer's words when switching moods.",
      "Do provide visible focus, generous targets and a final-open reduced-motion path.",
      "Do require separate closure, envelope, and letter gestures; offer immediate skip, keyboard focus progression, and replay."
    ],
    "donts": [
      "Don't add looping motion, scroll hijacking or hard home-section background cuts.",
      "Don't synthesize physical envelope or paper geometry with CSS."
    ]
  }
